{
  "name": "@noy-db/at-macos-keychain",
  "version": "0.9.0-pre.0",
  "description": "macOS Keychain sealing key provider for noy-db managed-secret mode \u2014 AES-256-GCM under a 32-byte key stored in the user's login Keychain. Desktop-app provider in the at-* family; pairs with Touch ID via Keychain Access UI.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/at/tree/main/at-macos-keychain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/at.git",
    "directory": "at-macos-keychain"
  },
  "bugs": {
    "url": "https://github.com/noy-db/at/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@napi-rs/keyring": "^1.1.0",
    "@noy-db/hub": "^0.7.0 || ^0.8.0-pre.0 || ^0.9.0-pre.1"
  },
  "peerDependenciesMeta": {
    "@napi-rs/keyring": {
      "optional": false
    }
  },
  "devDependencies": {
    "@napi-rs/keyring": "^1.1.0",
    "@noy-db/hub": "0.9.0-pre.2",
    "@noy-db/on-shamir": "0.8.0",
    "@noy-db/ports": "0.9.0-pre.2",
    "@noy-db/to-memory": "0.8.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "noy-db",
    "at-macos-keychain",
    "sealing-key-provider",
    "managed-secret",
    "macos",
    "keychain",
    "aes-256-gcm",
    "rubber-hose-resistant",
    "encryption",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {}
}
